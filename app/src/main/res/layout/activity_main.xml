<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:title="Reproductor de música"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TÍTULO DE LA CANCIÓN -->
    <TextView
        android:id="@+id/tvTituloCancion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Título de la canción"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <!-- TEXTO TIEMPO INICIO -->
    <TextView
        android:id="@+id/tvTiempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCancion"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"/>

    <!-- TEXTO TIEMPO FIN -->
    <TextView
        android:id="@+id/tvDuracion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTiempo"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"/>

    <!-- SEEK BAR -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCancion"
        app:layout_constraintStart_toEndOf="@id/tvTiempo"
        app:layout_constraintEnd_toStartOf="@id/tvDuracion"
        android:layout_marginTop="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- BOTÓN PLAY -->
    <Button
        android:id="@+id/btnPlay"
        android:layout_width="140dp"
        android:layout_height="70dp"
        android:text="Play"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPause"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"/>

    <!-- BOTÓN PAUSE -->
    <Button
        android:id="@+id/btnPause"
        android:layout_width="140dp"
        android:layout_height="70dp"
        android:text="Pause"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/btnPlay"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"/>

    <!-- BOTONES DE SONIDOS -->
    <LinearLayout
        android:id="@+id/sonidosContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSonido1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disparo con un rifle" />

        <Button
            android:id="@+id/btnSonido2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disparo a un objetivo en el entrenamiento" />

        <Button
            android:id="@+id/btnSonido3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Golpe aplastante con un sable" />

        <Button
            android:id="@+id/btnSonido4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Golpe magistral con la espada" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
